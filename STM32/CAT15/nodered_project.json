  {
    "id": "fn_irrigation_controller",
    "type": "function",
    "z": "tab_smart_irrigation",
    "name": "Irrigation Controller",
    "func": "// Evaluates Automatic and Manual Pump Control\nvar auto_mode = context.get('auto_mode') || false;\nvar manual_pump = context.get('manual_pump') || false;\n\nif (msg.topic === 'auto_mode') {\n    auto_mode = msg.payload;\n    context.set('auto_mode', auto_mode);\n} else if (msg.topic === 'manual_pump') {\n    manual_pump = msg.payload;\n    context.set('manual_pump', manual_pump);\n}\n\nvar pump_state = 'OFF';\nif (manual_pump) {\n    pump_state = 'ON';\n} else if (auto_mode) {\n    var soil_moisture = flow.get('soil_moisture') || 55;\n    if (soil_moisture <= 30) {\n        pump_state = 'ON';\n    } else {\n        pump_state = 'OFF';\n    }\n}\n\nreturn { payload: pump_state };",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 280,
    "y": 450,
    "wires": [
      ["ui_pump_status"]
    ]
  },
