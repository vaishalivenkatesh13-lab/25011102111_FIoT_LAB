  {
    "id": "fn_agri_processing",
    "type": "function",
    "z": "tab_smart_irrigation",
    "name": "Agriculture Processing",
    "func": "// Agriculture processing for Smart Irrigation\nvar d = msg.payload;\nflow.set('soil_moisture', d.moisture);\n\nvar irrigation_status = '';\nvar soil_condition = '';\nvar field_alert = '';\n\nif (d.moisture <= 30) {\n    irrigation_status = 'IRRIGATION ACTIVE';\n    soil_condition = 'DRY SOIL - IRRIGATION REQUIRED';\n    field_alert = 'DRY SOIL - IRRIGATION REQUIRED';\n} else if (d.moisture <= 70) {\n    irrigation_status = 'SOIL MOISTURE NORMAL';\n    soil_condition = 'SOIL MOISTURE NORMAL';\n    field_alert = 'SOIL MOISTURE NORMAL';\n} else {\n    irrigation_status = 'EXCESS WATER - PUMP OFF';\n    soil_condition = 'EXCESS WATER DETECTED';\n    field_alert = 'EXCESS WATER DETECTED';\n}\n\nreturn [\n    { payload: irrigation_status },\n    { payload: soil_condition },\n    { payload: d.temperature },\n    { payload: d.humidity },\n    { payload: d.moisture },\n    { payload: d.moisture },\n    { payload: field_alert },\n    { payload: d.humidity },\n    { payload: d.temperature }\n];",
    "outputs": 9,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 660,
    "wires": [
      ["ui_irrigation_status", "debug_3"],
      ["ui_soil_condition", "debug_2"],
      ["ui_gauge_temp", "debug_4"],
      ["ui_gauge_humidity", "debug_5"],
      ["ui_chart_moisture", "debug_6"],
      ["ui_gauge_moisture"],
      ["ui_field_alert"],
      ["ui_chart_humidity"],
      ["ui_chart_temp"]
    ]
  },
